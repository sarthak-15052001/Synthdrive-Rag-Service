):
    """
    Query the Kernel of Truth for relationship insights.
    
    This endpoint accepts a query string and optional parameters, processes it through
    the Kernel of Truth tool and returns relationship insights between entities.
    
    Example query: "What workflows did user John create?"
    """
    logger.info(f"Processing Kernel of Truth query: {request.query}")
    
    try:
        # Initialize the Kernel of Truth tool
        kernel_tool = KernelOfTruthTool(neo4j_client=neo4j_client)
        
        # Query for relationship insights
        results = await kernel_tool.query_relationships(
            user_query=request.query,
            tenant_id=request.tenant_id,
            max_depth=request.max_depth,
            limit=request.limit
        )
        
        # Create the response
        response = KernelOfTruthResponse(
            query=request.query,
            insights=results
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error processing Kernel of Truth query: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process Kernel of Truth query: {str(e)}",
        ) from e


@router.post("/planner")
async def plan_retrieval_strategy(
    request: PlannerRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    neo4j_client: Annotated[Neo4jClient, Depends(get_neo4j_client)],
):
    """
    Plan a retrieval strategy for a query.
    
    This endpoint analyzes a query and generates a retrieval strategy,
    determining the sequence of searches using Weaviate or Neo4j.
    
    Example query: "What tools are available for video generation?"
    """
    logger.info(f"Planning retrieval strategy for query: {request.query}")
    
    try:
        # Import the planner node
        from src.querying.planner import PlannerNode, PlannerState
        
        # Initialize the planner node
        planner = PlannerNode()
        
        # Create the planner state
        planner_state: PlannerState = {
            "original_query": request.query,
            "organization_id": request.organization_id,
            "plan": None,
            "retrieved_docs": [],
            "graph_insights": [],
            "final_answer": None,
            "error_log": []
        }
        
        # Generate the retrieval plan
        result = await planner.plan_retrieval(planner_state)
        
        # Check for errors
        if result.get("error_log") and len(result["error_log"]) > 0:
            error_message = result["error_log"][-1]
            logger.error(f"Error planning retrieval strategy: {error_message}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=f"Failed to plan retrieval strategy: {error_message}",
            )
        
        # Create the response
        response = PlannerResponse(
            query=request.query,
            organization_id=request.organization_id,
            plan=result.get("plan", "No plan generated")
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error planning retrieval strategy: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to plan retrieval strategy: {str(e)}",
        ) from e


@router.post("/vector-search-tools")
async def vector_search_tools(
    request: PlannerRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
):
    """
    Perform semantic vector search on global AI tools to discover relevant items based on the query.
    
    This endpoint simulates the Vector Search Tools node in SynthDrive's LangGraph flow.
    It queries Weaviate's Global_Tools collection for semantic matches to the query and returns
    the results as part of the state object.
    
    Example query: "find AI tools for video generation"
    """
    logger.info(f"Processing Vector Search Tools query: {request.query}")
    
    try:
        # Initialize the Vector Search Tools node
        vector_search_tools_node = VectorSearchToolsNode(weaviate_client=weaviate_client)
        
        # Create the initial state
        initial_state = {
            "original_query": request.query,
            "organization_id": request.organization_id,
            "plan": None,
            "retrieved_docs": [],
            "graph_insights": [],
            "final_answer": None,
            "error_log": []
        }
        
        # Search for AI tools using the Vector Search Tools node
        result_state = await vector_search_tools_node.search_ai_tools(initial_state)
        
        # Check for errors
        if result_state.get("error_log") and len(result_state["error_log"]) > 0:
            error_message = result_state["error_log"][-1]
            logger.error(f"Error in Vector Search Tools: {error_message}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=f"Failed to search for AI tools: {error_message}",
            )
        
        # Convert the retrieved tools to AITool objects
        tools = []
        for tool_data in result_state.get("retrieved_docs", []):
            tools.append(AITool(
                name=tool_data.get("name", "Unknown Tool"),
                description=tool_data.get("description", ""),
                use_case=tool_data.get("use_case", ""),
                url=tool_data.get("url", ""),
                category=tool_data.get("category", ""),
                pricing=tool_data.get("pricing", ""),
                reviews="",  # No reviews in the result
                rating=tool_data.get("rating", 0.0),
                tags=[],  # No tags in the result
                tool_id=tool_data.get("citation_id", ""),
                relevance_score=tool_data.get("relevance_score", 0.0),
                citation_id=tool_data.get("citation_id", "")
            ))
        
        # Create and return the response
        response = AIToolsSearchResponse(
            query=request.query,
            tools=tools
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error in Vector Search Tools: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to search for AI tools: {str(e)}",
        ) from e


@router.post("/vector-search-tenant-docs")
async def vector_search_tenant_docs(
    request: VectorSearchTenantDocsRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
):
    """
    Semantically search tenant-specific uploaded files, filtered by organization_id, to retrieve relevant documents.
    
    This endpoint simulates the Vector Search Docs node in SynthDrive's LangGraph system. It performs a semantic search
    in Weaviate's Tenant_UploadedFiles collection, filtered by organization_id, and returns the matching documents.
    
    Example query: "financial reports from 2023"
    """
    logger.info(f"Processing Vector Search Tenant Docs query: {request.query} for organization: {request.organization_id}")
    
    try:
        # Initialize the Vector Search Tenant Docs node
        vector_search_tenant_docs_node = VectorSearchTenantDocsNode(weaviate_client=weaviate_client)
        
        # Create the initial state
        initial_state = {
            "original_query": request.query,
            "organization_id": request.organization_id,
            "plan": None,
            "retrieved_docs": [],
            "graph_insights": [],
            "final_answer": None,
            "error_log": []
        }
        
        # Search for tenant documents using the Vector Search Tenant Docs node
        result_state = await vector_search_tenant_docs_node.search_tenant_documents(initial_state)
        
        # Check for errors
        if result_state.get("error_log") and len(result_state["error_log"]) > 0:
            error_message = result_state["error_log"][-1]
            logger.error(f"Error in Vector Search Tenant Docs: {error_message}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=f"Failed to search for tenant documents: {error_message}",
            )
        
        # Convert the retrieved documents to TenantUploadedFile objects
        files = []
        for doc in result_state.get("retrieved_docs", []):
            files.append(TenantUploadedFile(
                file_id=doc.get("file_id", ""),
                file_name=doc.get("file_name", "Unknown File"),
                file_path=doc.get("file_path", ""),
                content_chunk=doc.get("content", ""),  # Map content back to content_chunk
                organization_id=doc.get("organization_id", ""),
                upload_date=doc.get("upload_date", ""),
                file_type=doc.get("file_type", ""),
                tags=doc.get("tags", []),
                relevance_score=doc.get("relevance_score", 0.0),
                citation_id=doc.get("citation_id", "")
            ))
        
        # Create and return the response
        response = VectorSearchTenantDocsResponse(
            query=request.query,
            organization_id=request.organization_id,
            files=files
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error in Vector Search Tenant Docs: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to search for tenant documents: {str(e)}",
        ) from e


@router.post("/graph-rag-contextualizer")
async def graph_rag_contextualizer(
    request: GraphRAGContextualizerRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    neo4j_client: Annotated[Neo4jClient, Depends(get_neo4j_client)],
):
    """
    Query the Graph RAG Contextualizer to uncover relationships and provide deep context.
    
    This endpoint simulates the Graph RAG Contextualizer node in SynthDrive's LangGraph system.
    It queries Neo4j for relationships and context (e.g., multi-hop traversals) and returns
    insights that enhance the retrieved data.
    
    Example query: "Find workflows used by this team"
    """
    logger.info(f"Processing Graph RAG Contextualizer query: {request.query} for organization: {request.organization_id}")
    
    try:
        # Initialize the Graph RAG Contextualizer
        from src.querying.tools.graph_rag_contextualizer import GraphRAGContextualizer
        contextualizer = GraphRAGContextualizer(neo4j_client=neo4j_client)
        
        # Create the initial state
        initial_state = {
            "original_query": request.query,
            "organization_id": request.organization_id,
            "plan": None,
            "retrieved_docs": request.retrieved_docs,
            "graph_insights": [],
            "final_answer": None,
            "error_log": []
        }
        
        # Process the query with the Graph RAG Contextualizer
        result_state = await contextualizer.contextualize(initial_state)
        
        # Check for errors
        if result_state.get("error_log") and len(result_state["error_log"]) > 0:
            error_message = result_state["error_log"][-1]
            logger.error(f"Error in Graph RAG Contextualizer: {error_message}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=f"Failed to contextualize with graph relationships: {error_message}",
            )
        
        # Convert the graph insights to GraphInsight objects
        insights = []
        for insight in result_state.get("graph_insights", []):
            insights.append(GraphInsight(
                content=insight.get("content", ""),
                metadata=insight.get("metadata", {}),
                source=insight.get("source", "graph_database"),
                citation_id=insight.get("citation_id", ""),
                explanation=insight.get("explanation", ""),
                inferred_context=insight.get("inferred_context", "")
            ))
        
        # Create and return the response
        response = GraphRAGContextualizerResponse(
            query=request.query,
            organization_id=request.organization_id,
            graph_insights=insights
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error in Graph RAG Contextualizer: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process Graph RAG Contextualizer query: {str(e)}",
        ) from e


@router.post("/synthesizer")
async def synthesize_final_answer(
    request: SynthesizerRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
):
    """
    Synthesize a final answer from retrieved documents and graph insights.
    
    This endpoint simulates the Synthesizer node in SynthDrive's LangGraph system.
    It combines all retrieved documents and graph insights into a coherent, cited
    final response using an LLM.
    
    Example query: "What AI tools are available for video generation?"
    """
    logger.info(f"Processing Synthesizer request for query: {request.query} for organization: {request.organization_id}")
    
    try:
        # Initialize the Synthesizer
        synthesizer = Synthesizer()
        
        # Create the initial state
        initial_state = {
            "original_query": request.query,
            "organization_id": request.organization_id,
            "plan": None,
            "retrieved_docs": request.retrieved_docs,
            "graph_insights": request.graph_insights,
            "final_answer": None,
            "error_log": []
        }
        
        # Process the query with the Synthesizer
        result_state = await synthesizer.synthesize(initial_state)
        
        # Check for errors
        if result_state.get("error_log") and len(result_state["error_log"]) > 0:
            error_message = result_state["error_log"][-1]
            logger.error(f"Error in Synthesizer: {error_message}")
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail=f"Failed to synthesize final answer: {error_message}",
            )
        
        # Create and return the response
        response = SynthesizerResponse(
            query=request.query,
            organization_id=request.organization_id,
            final_answer=result_state.get("final_answer", "No answer generated")
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error in Synthesizer: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process Synthesizer request: {str(e)}",
        ) from e


@router.post("/conditional-edge-router")
async def conditional_edge_router(
    request: ConditionalEdgeRouterRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
):
    """
    Evaluate the current state and decide the next step in the flow.
    
    This endpoint simulates the Conditional Edge Router node in SynthDrive's LangGraph system.
    It evaluates the current state object and decides which node to route to next based on
    the query progress, retrieved documents, and other factors.
    
    Example query: "What AI tools are available for video generation?"
    """
    logger.info(f"Processing Conditional Edge Router request for query: {request.original_query}")
    
    # Check Weaviate connectivity first
    try:
        # Test Weaviate connection by getting schema
        weaviate_client.client.schema.get()
    except Exception as wv_error:
        logger.error(f"Weaviate connectivity test failed: {str(wv_error)}")
        error_message = f"Weaviate connectivity issue detected: {str(wv_error)}"
        
        # Add to error log if not already present
        error_log = request.error_log.copy() if request.error_log else []
        if error_message not in error_log:
            error_log.append(error_message)
        
        # Return error handling response
        return ConditionalEdgeRouterResponse(
            original_query=request.original_query,
            organization_id=request.organization_id,
            next_node="error_handling",
            reason="There is a connectivity issue with Weaviate which must be resolved before further steps can be executed.",
            updated_state={
                "original_query": request.original_query,
                "organization_id": request.organization_id,
                "plan": request.plan,
                "retrieved_docs": request.retrieved_docs,
                "graph_insights": request.graph_insights,
                "final_answer": request.final_answer,
                "error_log": error_log,
                "next_node": "error_handling",
                "routing_reason": "Weaviate connectivity issue detected"
            }
        )
    
    try:
        # Import the Conditional Edge Router
        from src.querying.tools.conditional_edge_router import ConditionalEdgeRouter
        router = ConditionalEdgeRouter()
        
        # Create the initial state
        initial_state = {
            "original_query": request.original_query,
            "organization_id": request.organization_id,
            "plan": request.plan,
            "retrieved_docs": request.retrieved_docs,
            "graph_insights": request.graph_insights,
            "final_answer": request.final_answer,
            "error_log": request.error_log
        }
        
        # Process the request with the Conditional Edge Router
        result_state = await router.route(initial_state)
        
        # Check if the router decided to route to error_handling
        if result_state.get("next_node") == "error_handling":
            # This is not an error in the router, just a routing decision
            if result_state.get("error_log") and len(result_state["error_log"]) > len(request.error_log):
                error_message = result_state["error_log"][-1]
                # Log as info, not error, since this is expected behavior
                logger.info(f"Router decided to route to error_handling: {error_message}")
            else:
                logger.info(f"Router decided to route to error_handling based on state evaluation")
        # Check for actual errors in the error_log that aren't related to routing decisions
        elif result_state.get("error_log") and len(result_state["error_log"]) > len(request.error_log):
            error_message = result_state["error_log"][-1]
            logger.warning(f"Error logged in Conditional Edge Router: {error_message}")
            # Don't raise an exception, just log the warning
        
        # Create and return the response
        response = ConditionalEdgeRouterResponse(
            original_query=request.original_query,
            organization_id=request.organization_id,
            next_node=result_state.get("next_node", "error_handling"),
            reason=result_state.get("routing_reason", "No reason provided"),
            updated_state=result_state
        )
        
        return response
        
    except Exception as e:
        # Log as warning instead of error since we're handling it gracefully
        logger.warning(f"Exception in Conditional Edge Router: {str(e)}")
        import traceback
        logger.warning(f"Traceback: {traceback.format_exc()}")
        
        # Return a response with error_handling node instead of raising an exception
        return ConditionalEdgeRouterResponse(
            original_query=request.original_query,
            organization_id=request.organization_id,
            next_node="error_handling",
            reason=f"Exception occurred: {str(e)}",
            updated_state={
                "original_query": request.original_query,
                "organization_id": request.organization_id,
                "plan": request.plan,
                "retrieved_docs": request.retrieved_docs,
                "graph_insights": request.graph_insights,
                "final_answer": request.final_answer,
                "error_log": request.error_log + [f"Exception occurred: {str(e)}"],
                "next_node": "error_handling",
                "routing_reason": f"Exception occurred: {str(e)}"
            }
        )