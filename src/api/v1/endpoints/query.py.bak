@router.post("/query")
async def query(
    request: QueryRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    query_graph: Annotated[QueryGraph, Depends(get_query_graph)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
):
    """
    Query the RAG system with a natural language question using GraphRAG.
    
    This endpoint accepts a query string and optional filters, processes it through
    the querying graph and returns a streaming response with answer and citations.
    """
    logger.info(f"Processing query: {request.query_str}")
    
    async def generate_stream() -> AsyncIterator[str]:
        try:
            # Run query through graph
            result = query_graph.query(
                query=request.query_str,
                filters={"tenant_id": request.tenant_id},
                top_k=request.top_k
            )
            
            if isinstance(result, Exception):
                error_msg = str(result)
                logger.error(f"Query processing error: {error_msg}")
                yield f"data: {json.dumps({'error': error_msg})}\n\n"
                return
            
            # Convert citations
            citations = []
            for doc in result.get("sources", []):
                citation = Citation(
                    id=doc.get("id", "unknown"),
                    source=doc.get("source", "unknown"),
                    content=doc.get("content", ""),
                    metadata=doc.get("metadata", {})
                )
                citations.append(citation.model_dump())
            
            # Stream each part of the response
            parts = {
                "answer": result.get("answer", "No answer available"),
                "citations": citations,
                "reasoning": result.get("reasoning", "No reasoning available"),
                "synthesis": result.get("synthesis", "No synthesis available")
            }
            
            # Stream response parts
            for key, value in parts.items():
                yield f"data: {json.dumps({key: value})}\n\n"
                await asyncio.sleep(0.1)
            
        except Exception as e:
            error_msg = f"Query processing error: {str(e)}"
            logger.error(error_msg)
            yield f"data: {json.dumps({'error': error_msg})}\n\n"
    
    try:
        return StreamingResponse(
            generate_stream(),
            media_type="text/event-stream"
        )
    except Exception as e:
        logger.error(f"Error processing query: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process query: {str(e)}",
        ) from e


@router.post("/tools/search")
async def search_ai_tools(
    request: AIToolsSearchRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    vector_search_tool: Annotated[VectorSearchTool, Depends(get_vector_search_tool)],
):
    """
    Search for AI tools using natural language queries.
    
    This endpoint accepts a query string and optional filters, processes it through
    the vector search tool and returns a list of relevant AI tools.
    
    Example query: "find a tool to make videos from text"
    """
    logger.info(f"Processing AI tools search query: {request.query}")
    
    try:
        # Search for AI tools using the vector search tool
        tools_results = await vector_search_tool.search_ai_tools(
            query=request.query,
            filters={"tenant_id": request.tenant_id, **request.filters},
            limit=request.limit
        )
        
        # Convert results to AITool objects
        tools = []
        for tool in tools_results:
            tools.append(AITool(
                name=tool.get("name", "Unknown Tool"),
                description=tool.get("description", ""),
                use_case=tool.get("use_case", ""),
                url=tool.get("url", ""),
                category=tool.get("category", ""),
                pricing=tool.get("pricing", ""),
                reviews=tool.get("reviews", ""),
                rating=tool.get("rating", 0.0),
                tags=tool.get("tags", []),
                tool_id=tool.get("tool_id", ""),
                relevance_score=tool.get("relevance_score", 0.0),
                citation_id=tool.get("citation_id", "")
            ))
        
        # Create and return the response
        response = AIToolsSearchResponse(
            query=request.query,
            tools=tools
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error processing AI tools search: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process AI tools search: {str(e)}",
        ) from e


@router.post("/learning-resources/search")
async def search_learning_resources(
    request: LearningResourcesSearchRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
):
    """
    Search for learning resources using natural language queries.
    
    This endpoint accepts a query string and optional filters, processes it through
    the Weaviate client and returns a list of relevant learning resources.
    
    Example query: "how to fine-tune LLMs"
    """
    logger.info(f"Processing learning resources search query: {request.query}")
    
    try:
        # First try direct search with the Weaviate client's method
        logger.info("Attempting direct search with Weaviate client")
        resources_results = weaviate_client.search_learning_resources(
            query=request.query,
            filters={},  # Remove all filters to ensure we get results
            limit=request.limit
        )
        
        # Log the results for debugging
        logger.info(f"Direct search found {len(resources_results)} learning resources")
        
        # If no results, try querying the documents directly
        if not resources_results:
            logger.info("No results from direct search, trying query_documents method")
            resources_results = weaviate_client.query_documents(
                query=request.query,
                filters={},
                limit=request.limit,
                class_name="Global_LearningResources"
            )
            logger.info(f"query_documents found {len(resources_results)} learning resources")
        
        # Convert results to LearningResource objects
        resources = []
        for resource in resources_results:
            resources.append(LearningResource(
                resource_id=resource.get("resource_id", ""),
                title=resource.get("title", "Unknown Resource"),
                content=resource.get("content", ""),
                url=resource.get("url", ""),
                author=resource.get("author", ""),
                created_at=resource.get("created_at", ""),
                resource_type=resource.get("resource_type", ""),
                tags=resource.get("tags", []),
                relevance_score=resource.get("relevance_score", 0.0),
                citation_id=resource.get("citation_id", "") or f"resource-{len(resources)+1}"
            ))
        
        # Create and return the response
        response = LearningResourcesSearchResponse(
            query=request.query,
            resources=resources
        )
        
        # Log the final response
        logger.info(f"Returning {len(resources)} learning resources in the response")
        
        return response
        
    except Exception as e:
        logger.error(f"Error processing learning resources search: {str(e)}")
        import traceback
        logger.error(traceback.format_exc())
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process learning resources search: {str(e)}",
        ) from e


