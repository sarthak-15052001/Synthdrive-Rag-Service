@router.post("/global-knowledge/ai-tools")
async def global_knowledge_ai_tools(
    request: AIToolsSearchRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
):
    """
    Search for AI tools using natural language queries with the Global Knowledge Domain.
    
    This endpoint simulates the SynthDrive system's Global Knowledge Domain for Vetted AI Tools.
    It uses Weaviate for semantic search on tool descriptions and use cases, and provides
    explanations for why each tool matches the query.
    
    Example query: "tool for video from text"
    """
    logger.info(f"Processing Global Knowledge Domain AI tools search query: {request.query}")
    
    try:
        # Initialize the Global Knowledge Domain
        global_knowledge_domain = GlobalKnowledgeDomain(weaviate_client=weaviate_client)
        
        # Search for AI tools using the Global Knowledge Domain
        result = await global_knowledge_domain.search_ai_tools(
            query=request.query,
            filters={"tenant_id": request.tenant_id, **request.filters},
            limit=request.limit,
            explain=True
        )
        
        # Convert results to AITool objects
        tools = []
        for tool_data in result.get("tools", []):
            # Get explanation for this tool if available
            explanation = result.get("explanations", {}).get(tool_data.get("name", ""), "")
            
            tools.append(AITool(
                name=tool_data.get("name", "Unknown Tool"),
                description=tool_data.get("description", ""),
                use_case=tool_data.get("use_case", ""),
                url=tool_data.get("url", ""),
                category=tool_data.get("category", ""),
                pricing=tool_data.get("pricing", ""),
                reviews=explanation,  # Use the explanation as the reviews field
                rating=tool_data.get("rating", 0.0),
                tags=[],  # No tags in the result
                tool_id=f"tool-{i+1}" if 'i' in locals() else "tool-unknown",
                relevance_score=tool_data.get("relevance_score", 0.0),
                citation_id=f"gkd-{i+1}" if 'i' in locals() else "gkd-unknown"
            ))
        
        # Create and return the response
        response = AIToolsSearchResponse(
            query=request.query,
            tools=tools
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error processing Global Knowledge Domain AI tools search: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process Global Knowledge Domain AI tools search: {str(e)}",
        ) from e


@router.post("/tenant-files/search")
async def search_tenant_uploaded_files(
    request: TenantUploadedFilesSearchRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
):
    """
    Search for tenant uploaded files using natural language queries.
    
    This endpoint accepts a query string, organization ID, and optional filters,
    processes it through the Weaviate client and returns a list of relevant file chunks.
    
    Example query: "financial reports from 2023"
    """
    logger.info(f"Processing tenant uploaded files search query: {request.query} for organization {request.organization_id}")
    
    try:
        # Initialize the tenant uploaded files search tool
        tenant_files_search_tool = TenantUploadedFilesSearchTool(weaviate_client=weaviate_client)
        
        # Search for tenant uploaded files
        search_response = await tenant_files_search_tool.search_tenant_files(
            query=request.query,
            organization_id=request.organization_id,
            tenant_id=request.tenant_id,
            filters=request.filters,
            limit=request.limit
        )
        
        # Get the results from the response
        files_results = search_response.get("results", [])
        
        # Convert results to TenantUploadedFile objects
        files = []
        for file in files_results:
            files.append(TenantUploadedFile(
                file_id=file.get("file_id", ""),
                file_name=file.get("file_name", "Unknown File"),
                file_path=file.get("file_path", ""),
                content_chunk=file.get("content_chunk", ""),
                organization_id=file.get("organization_id", ""),
                upload_date=file.get("upload_date", ""),
                file_type=file.get("file_type", ""),
                tags=file.get("tags", []),
                relevance_score=file.get("relevance_score", 0.0),
                citation_id=file.get("citation_id", "")
            ))
        
        # Create and return the response
        response = TenantUploadedFilesSearchResponse(
            query=request.query,
            files=files
        )
        
        return response
        
    except Exception as e:
        logger.error(f"Error processing tenant uploaded files search: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process tenant uploaded files search: {str(e)}",
        ) from e


@router.get("/tenant-files/{file_id}")
async def get_tenant_file_by_id(
    file_id: str,
    organization_id: str,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
    tenant_id: str = "default",
):
    """
    Get a specific tenant uploaded file by ID.
    
    This endpoint retrieves a specific file chunk by its ID, organization ID, and tenant ID.
    """
    logger.info(f"Getting tenant uploaded file with ID {file_id} for organization {organization_id}")
    
    try:
        # Initialize the tenant uploaded files search tool
        tenant_files_search_tool = TenantUploadedFilesSearchTool(weaviate_client=weaviate_client)
        
        # Get the file by ID
        file_data = await tenant_files_search_tool.get_file_by_id(
            file_id=file_id,
            organization_id=organization_id,
            tenant_id=tenant_id
        )
        
        if not file_data:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"File with ID {file_id} not found for organization {organization_id}",
            )
        
        # Convert to TenantUploadedFile object
        file = TenantUploadedFile(
            file_id=file_data.get("file_id", ""),
            file_name=file_data.get("file_name", "Unknown File"),
            file_path=file_data.get("file_path", ""),
            content_chunk=file_data.get("content_chunk", ""),
            organization_id=file_data.get("organization_id", ""),
            upload_date=file_data.get("upload_date", ""),
            file_type=file_data.get("file_type", ""),
            tags=file_data.get("tags", []),
            relevance_score=1.0,  # Direct lookup has perfect relevance
            citation_id=f"file-{file_id}"
        )
        
        return file
        
    except HTTPException:
        # Re-raise HTTP exceptions
        raise
    except Exception as e:
        logger.error(f"Error getting tenant uploaded file: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to get tenant uploaded file: {str(e)}",
        ) from e

@router.post("/tenant-files/search-with-prompt")
async def search_tenant_files_with_prompt(
    request: TenantUploadedFilesSearchRequest,
    current_user: Annotated[Dict[str, Any], Depends(get_current_user)],
    weaviate_client: Annotated[WeaviateClient, Depends(get_weaviate_client)],
):
    """
    Search for tenant uploaded files and generate a prompt for LLM processing.
    
    This endpoint accepts a query string, organization ID, and optional filters,
    processes it through the Weaviate client and returns both the search results
    and a prompt template for LLM processing.
    
    Example query: "financial reports from 2023"
    """
    logger.info(f"Processing tenant files search with prompt for organization {request.organization_id}")
    
    try:
        # Initialize the tenant uploaded files search tool
        tenant_files_search_tool = TenantUploadedFilesSearchTool(weaviate_client=weaviate_client)
        
        # Search for tenant uploaded files and generate prompt
        response_data = await tenant_files_search_tool.search_and_generate_prompt(
            query=request.query,
            organization_id=request.organization_id,
            tenant_id=request.tenant_id,
            filters=request.filters,
            limit=request.limit
        )
        
        # Get the results and prompt from the response
        files_results = response_data.get("results", [])
        prompt = response_data.get("prompt", "")
        
        # Convert results to TenantUploadedFile objects
        files = []
        for file in files_results:
            files.append(TenantUploadedFile(
                file_id=file.get("file_id", ""),
                file_name=file.get("file_name", "Unknown File"),
                file_path=file.get("file_path", ""),
                content_chunk=file.get("content_chunk", ""),
                organization_id=file.get("organization_id", ""),
                upload_date=file.get("upload_date", ""),
                file_type=file.get("file_type", ""),
                tags=file.get("tags", []),
                relevance_score=file.get("relevance_score", 0.0),
                citation_id=file.get("citation_id", "")
            ))
        
        # Create the base response
        search_response = TenantUploadedFilesSearchResponse(
            query=request.query,
            files=files
        )
        
        # Add the prompt to the response
        response_with_prompt = {
            "search_results": search_response.model_dump(),
            "prompt": prompt
        }
        
        return response_with_prompt
        
    except Exception as e:
        logger.error(f"Error processing tenant files search with prompt: {str(e)}")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to process tenant files search with prompt: {str(e)}",
        ) from e


@router.post("/kernel-of-truth/query")
